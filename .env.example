SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@batterywala.local
ADMIN_PASSWORD=ChangeMe123!
MAX_UPLOAD_MB=25
DATABASE_URL=sqlite:///batterywala.db
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMS_WEBHOOK_URL=
# Public HTTPS origin for quotation links sent by SMS (no trailing path).
PUBLIC_BASE_URL=
# Server-side Gemini key for Google Search grounding. Never expose it in browser JavaScript.
GEMINI_API_KEY=
# Cheapest model that supports Google Search grounding for this lightweight lookup.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional direct Google-results provider for low-cost testing (takes precedence over Gemini).
SERPER_API_KEY=
# Optional SerpApi key for Google AI Overview parity (takes precedence over Serper).
SERPAPI_API_KEY=
# Only results from these domains can influence or appear in a recommendation.
BATTERY_SEARCH_ALLOWED_DOMAINS=exidecare.com,amaron.com,livguard.com,luminousindia.com,sfsonicpower.com
